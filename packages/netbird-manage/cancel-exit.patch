diff --git a/internal/helpers/helpers_test.go b/internal/helpers/helpers_test.go
new file mode 100644
index 0000000..19c949c
--- /dev/null
+++ b/internal/helpers/helpers_test.go
@@ -0,0 +1,42 @@
+package helpers
+
+import (
+	"errors"
+	"testing"
+)
+
+// A declined single delete must surface as an error. Returning nil made the CLI
+// exit 0 while nothing was deleted, so an agent reading the exit status alone
+// believed the resource was gone.
+func TestConfirmSingleDeletionDeclinedIsAnError(t *testing.T) {
+	old := SkipConfirmation
+	SkipConfirmation = true // exercises the accepted path first
+	defer func() { SkipConfirmation = old }()
+
+	if err := ConfirmSingleDeletion("peer", "p", "id", nil); err != nil {
+		t.Fatalf("confirmed delete returned %v", err)
+	}
+
+	SkipConfirmation = false
+	// No stdin reader in a test binary yields EOF, which is the same path a
+	// closed stdin takes in automation.
+	err := ConfirmSingleDeletion("peer", "p", "id", nil)
+	if !errors.Is(err, ErrCancelled) {
+		t.Fatalf("declined delete returned %v, want ErrCancelled", err)
+	}
+}
+
+func TestConfirmBulkDeletionDeclinedIsAnError(t *testing.T) {
+	old := SkipConfirmation
+	SkipConfirmation = true
+	defer func() { SkipConfirmation = old }()
+
+	if err := ConfirmBulkDeletion("groups", []string{"a"}, 1); err != nil {
+		t.Fatalf("confirmed bulk delete returned %v", err)
+	}
+
+	SkipConfirmation = false
+	if err := ConfirmBulkDeletion("groups", []string{"a"}, 1); !errors.Is(err, ErrCancelled) {
+		t.Fatalf("declined bulk delete returned %v, want ErrCancelled", err)
+	}
+}
