diff --git a/internal/config/config_test.go b/internal/config/config_test.go
new file mode 100644
index 0000000..704ab4b
--- /dev/null
+++ b/internal/config/config_test.go
@@ -0,0 +1,101 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// The environment must win over a stale config file, otherwise an agent given a
+// token in its environment silently talks to whatever the last interactive
+// `connect` left behind.
+func TestEnvTokenBeatsConfigFile(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv(EnvToken, "env-token")
+	t.Setenv(EnvAPIURL, "https://selfhosted.example/api")
+
+	if err := os.WriteFile(
+		filepath.Join(home, configFileName),
+		[]byte(`{"token":"file-token","management_url":"https://api.netbird.io/api"}`),
+		0o600,
+	); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg, err := Load()
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if cfg.Token != "env-token" {
+		t.Errorf("token = %q, want env-token", cfg.Token)
+	}
+	if cfg.ManagementURL != "https://selfhosted.example/api" {
+		t.Errorf("url = %q, want self-hosted env url", cfg.ManagementURL)
+	}
+}
+
+// A self-hosted URL must be usable with nothing but env vars, so no config file
+// and no $HOME write is required.
+func TestEnvOnlyWithSelfHostedURL(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv(EnvToken, "env-token")
+	t.Setenv(EnvAPIURL, "https://netbird.internal/api")
+
+	cfg, err := Load()
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if cfg.ManagementURL != "https://netbird.internal/api" {
+		t.Errorf("url = %q", cfg.ManagementURL)
+	}
+}
+
+// Without EnvAPIURL the default stays the cloud API.
+func TestEnvTokenDefaultsToCloudURL(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv(EnvToken, "env-token")
+	t.Setenv(EnvAPIURL, "")
+
+	cfg, err := Load()
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if cfg.ManagementURL != DefaultCloudURL {
+		t.Errorf("url = %q, want %q", cfg.ManagementURL, DefaultCloudURL)
+	}
+}
+
+// The file path still works when the environment is empty.
+func TestConfigFileFallback(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv(EnvToken, "")
+	t.Setenv(EnvAPIURL, "")
+
+	if err := os.WriteFile(
+		filepath.Join(home, configFileName),
+		[]byte(`{"token":"file-token","management_url":"https://netbird.internal/api"}`),
+		0o600,
+	); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg, err := Load()
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if cfg.Token != "file-token" || cfg.ManagementURL != "https://netbird.internal/api" {
+		t.Errorf("got %+v", cfg)
+	}
+}
+
+func TestNoCredentials(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv(EnvToken, "")
+	t.Setenv(EnvAPIURL, "")
+
+	if _, err := Load(); err == nil {
+		t.Fatal("expected an error when neither env nor file supplies a token")
+	}
+}
